# Whitelist: only code, the preregistration and the public README/licences are tracked.
# Internal notes (status, pilot report, design extraction, QC images) stay out of the repository.
/*
!/.gitignore
!/README.md
!/LICENSE
!/code/
!/TOAM_preregistration_HAV_v2.docx
.DS_Store
__pycache__/
.venv/
.pytest_cache/
# site settings (server paths, licence files) stay local; see code/site.example.sh
/code/site.local.sh
